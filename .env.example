# AWS credentials for Amazon Bedrock
AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# Or use AWS SSO / IAM roles — boto3 picks up standard credential chain

# Bedrock model to use for generation
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Strands Decider 2B server
DECIDER_SERVER_URL=http://localhost:8000
DECIDER_MODEL=StrandsAgents/strands-decider-2B-hobson-v19

# Relevance threshold: chunks scoring below this are excluded from context
# Range: 0.0 - 1.0  |  Recommended: 0.55
RELEVANCE_THRESHOLD=0.55

# Max chunks to pass to Bedrock even if many score above threshold
MAX_CONTEXT_CHUNKS=6
